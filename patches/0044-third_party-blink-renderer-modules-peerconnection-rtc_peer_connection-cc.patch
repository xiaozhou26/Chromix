+namespace {
+// FORTRESS: persona srflx rewrite for the JS-visible local descriptions.
+// Mirrors the candidate-platform path (onicecandidate events) so that
+// localDescription.sdp and the candidate events agree: srflx connection
+// addresses become the persona egress IP (uxr-webrtc-ip). In-place + idempotent
+// so the [SameObject] description keeps object identity across reads.
+RTCSessionDescription* RewritePersonaSrflx(RTCSessionDescription* desc) {
+  if (!desc) {
+    return nullptr;
+  }
+  std::string ph_ip = base::UxrConfig::GetInstance().Get("uxr-webrtc-ip");
+  if (ph_ip.empty()) {
+    return desc;
+  }
+  const std::string ph_sdp = desc->sdp().Utf8();
+  std::string ph_out;
+  size_t ph_line_start = 0;
+  bool ph_changed = false;
+  while (ph_line_start <= ph_sdp.size()) {
+    const size_t ph_nl = ph_sdp.find('\n', ph_line_start);
+    const size_t ph_line_end =
+        ph_nl == std::string::npos ? ph_sdp.size() : ph_nl;
+    const std::string ph_line =
+        ph_sdp.substr(ph_line_start, ph_line_end - ph_line_start);
+    if (ph_line.rfind("a=candidate:", 0) == 0 &&
+        ph_line.find(" typ srflx ") != std::string::npos) {
+      std::vector<std::string> ph_tokens;
+      std::string ph_tok;
+      for (char ph_c : ph_line) {
+        if (ph_c == ' ') {
+          ph_tokens.push_back(ph_tok);
+          ph_tok.clear();
+        } else {
+          ph_tok += ph_c;
+        }
+      }
+      ph_tokens.push_back(ph_tok);
+      // a=candidate:<foundation> <component> <transport> <priority> <address> <port> ...
+      if (ph_tokens.size() > 5 && ph_tokens[4] != ph_ip) {
+        ph_tokens[4] = ph_ip;
+        std::string ph_new_line;
+        for (size_t ph_i = 0; ph_i < ph_tokens.size(); ++ph_i) {
+          if (ph_i) {
+            ph_new_line += ' ';
+          }
+          ph_new_line += ph_tokens[ph_i];
+        }
+        ph_out += ph_new_line;
+        ph_changed = true;
+      } else {
+        ph_out += ph_line;
+      }
+    } else {
+      ph_out += ph_line;
+    }
+    ph_out += '\n';
+    if (ph_nl == std::string::npos) {
+      break;
+    }
+    ph_line_start = ph_nl + 1;
+  }
+  if (ph_changed) {
+    if (!ph_out.empty() && ph_out.back() == '\n' && ph_sdp.back() != '\n') {
+      ph_out.pop_back();  // do not invent a trailing newline
+    }
+    desc->setSdp(String::FromUtf8(ph_out));
+  }
+  return desc;
+}
+}  // namespace
