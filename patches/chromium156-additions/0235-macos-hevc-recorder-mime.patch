+std::string HEVCCodecSuffix(
+    const media::mp4::HEVCDecoderConfigurationRecord& config) {
+  std::string suffix = ".";
+  if (config.general_profile_space)
+    suffix += 'A' + config.general_profile_space - 1;
+  suffix += std::to_string(config.general_profile_idc);
+  uint32_t compatibility = 0;
+  for (int bit = 0; bit < 32; ++bit) {
+    compatibility = (compatibility << 1) |
+                    ((config.general_profile_compatibility_flags >> bit) & 1);
+  }
+  suffix += base::StringPrintf(".%X.%c%u", compatibility,
+                               config.general_tier_flag ? 'H' : 'L',
+                               config.general_level_idc);
+  // ISO/IEC 14496-15 omits trailing zero constraint bytes, not leading ones.
+  for (int shift = 40; shift >= 0; shift -= 8) {
+    if (!(config.general_constraint_indicator_flags &
+          ((uint64_t{1} << (shift + 8)) - 1)))
+      break;
+    suffix += base::StringPrintf(
+        ".%02X",
+        static_cast<unsigned>(
+            (config.general_constraint_indicator_flags >> shift) & 0xff));
+  }
+  return suffix;
 }
 #endif
 
