+GLint ClampPersonaLimit(gpu::gles2::GLES2Interface* gl,
+                        GLenum pname,
+                        int persona_value) {
+  GLint real = 0;
+  gl->GetIntegerv(pname, &real);
+  const GLint value = std::max(0, persona_value);
+  return real > 0 && value > real ? real : value;
+}
+
+GLfloat ClampPersonaLimitF(gpu::gles2::GLES2Interface* gl,
+                           GLenum pname,
+                           float persona_value) {
+  GLfloat real = 0.0f;
+  gl->GetFloatv(pname, &real);
+  const GLfloat value = std::max(0.0f, persona_value);
+  return real > 0.0f && value > real ? real : value;
+}
+
+GLint PersonaMaxVaryingVectors(gpu::gles2::GLES2Interface* gl) {
+  return ClampPersonaLimit(
+      gl, GL_MAX_VARYING_VECTORS,
+      ungoogled::CurrentPersona().webgl_max_varying_vectors);
 }
 
