+struct UxrCodecCapabilities {
+  bool supported = false;
+  bool smooth = false;
+  bool power_efficient = false;
+};
+
+// A present codec key maps that family. Values are exact comma-separated
+// tokens: supported,smooth,power-efficient. Unknown tokens are ignored.
+bool GetUxrCodecCapabilities(media::VideoCodec codec,
+                             UxrCodecCapabilities* out) {
+  const char* key = nullptr;
+  switch (codec) {
+    case media::VideoCodec::kH264:
+      key = "uxr-codec-h264";
+      break;
+    case media::VideoCodec::kVP8:
+      key = "uxr-codec-vp8";
+      break;
+    case media::VideoCodec::kVP9:
+      key = "uxr-codec-vp9";
+      break;
+    case media::VideoCodec::kAV1:
+      key = "uxr-codec-av1";
+      break;
+    case media::VideoCodec::kHEVC:
+      key = "uxr-codec-hevc";
+      break;
+    default:
+      return false;
+  }
+
+  const base::UxrConfig& config = base::UxrConfig::GetInstance();
+  if (!config.Has(key)) {
+    return false;
+  }
+
+  UxrCodecCapabilities capabilities;
+  for (const std::string& token :
+       base::SplitString(config.Get(key), ",", base::KEEP_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    if (token == "supported") {
+      capabilities.supported = true;
+    } else if (token == "smooth") {
+      capabilities.smooth = true;
+    } else if (token == "power-efficient") {
+      capabilities.power_efficient = true;
+    }
+  }
+
+  capabilities.smooth &= capabilities.supported;
+  capabilities.power_efficient &= capabilities.supported;
+  *out = capabilities;
+  return true;
+}
+
+template <typename InfoType>
+void ApplyUxrCodecCapabilities(media::VideoCodec codec, InfoType* info) {
+  UxrCodecCapabilities capabilities;
+  if (!GetUxrCodecCapabilities(codec, &capabilities)) {
+    return;
+  }
+
+  // Never promote a configuration that Chromium found unsupported.
+  const bool supported = info->supported() && capabilities.supported;
+  info->setSupported(supported);
+  info->setSmooth(supported && capabilities.smooth);
+  info->setPowerEfficient(supported && capabilities.power_efficient);
+}
