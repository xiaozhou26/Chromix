 bool Screen::isExtended() const {
+  {  // FORTRESS: persona multi-monitor flag. Headless reports a single
+    // display; a persona claiming a multi-screen desk can pin it here.
+    std::string ph_v = base::UxrConfig::GetInstance().Get("uxr-screen-extended");
+    if (!ph_v.empty()) {
+      return ph_v == "true" || ph_v == "1";
+    }
