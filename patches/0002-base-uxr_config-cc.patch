+uint64_t SeedFromCanvasKey(const UxrConfig& cfg) {
+  // Independent hardware templates are only for explicit synthetic tests.
+  if (cfg.Get("uxr-synthetic-device-tests") != "true")
+    return 0u;
+  uint64_t seed = 0;
+  const std::string primary = cfg.Get("uxr-fingerprint-seed");
+  const std::string raw = primary.empty() ? cfg.Get("uxr-canvas-seed") : primary;
+  if (raw.empty() || !base::StringToUint64(raw, &seed))
+    return 0u;
+  return seed;
+}
+
+template <typename T, size_t N>
+const T& PickSeeded(const std::array<T, N>& pool, uint64_t seed,
+                    unsigned T::*weight_field) {
+  std::mt19937_64 rng(seed);
+  unsigned total_weight = 0;
+  for (const auto& entry : pool)
+    total_weight += entry.*weight_field;
+  unsigned bucket = static_cast<unsigned>(rng() % total_weight);
+  for (const auto& entry : pool) {
+    if (bucket < entry.*weight_field)
+      return entry;
+    bucket -= entry.*weight_field;
+  }
+  return pool.back();
+}
+
+}  // namespace
