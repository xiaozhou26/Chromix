 void Geolocation::QueryNextPosition() {
+  if (device::mojom::blink::GeopositionPtr position = UxrGeoposition()) {
+    GetExecutionContext()
+        ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+        ->PostTask(
+            FROM_HERE,
+            blink::BindOnce(
+                &Geolocation::OnPositionUpdated, WrapPersistent(this),
+                device::mojom::blink::GeopositionResult::NewPosition(
+                    std::move(position))));
+    return;
+  }
   geolocation_->QueryNextPosition(
       blink::BindOnce(&Geolocation::OnPositionUpdated, WrapPersistent(this)));
 }
