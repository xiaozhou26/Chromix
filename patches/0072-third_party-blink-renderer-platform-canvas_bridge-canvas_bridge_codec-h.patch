+
+struct HelloMessage { uint32_t protocol_version = 1; uint64_t persona_seed = 0; std::string client_version; };
+struct WelcomeMessage { uint32_t protocol_version = 0; std::string server_version; std::string os; std::string gpu_vendor; std::string gpu_renderer; };
+struct CreateCanvas2DMessage { uint32_t canvas_id = 0; uint32_t width = 0; uint32_t height = 0; bool opaque = false; };
+struct Canvas2DOpMessage { uint32_t canvas_id = 0; uint32_t op = 0; std::string str_arg; std::vector<double> args; };
+struct MeasureTextMessage { uint32_t canvas_id = 0; std::string text; };
+struct CreateWebGLMessage { uint32_t canvas_id = 0; uint32_t width = 0; uint32_t height = 0; uint32_t context_type = 1; };
+struct WebGLOpMessage { uint32_t canvas_id = 0; uint32_t op = 0; std::vector<int32_t> ints; std::vector<double> floats; std::string str; std::vector<uint8_t> data; };
+struct GetImageDataMessage { uint32_t canvas_id = 0; int32_t x = 0; int32_t y = 0; uint32_t width = 0; uint32_t height = 0; uint32_t content_version = 0; };
+struct ImageDataMessage { uint32_t canvas_id = 0; uint32_t width = 0; uint32_t height = 0; std::vector<uint8_t> pixels; uint32_t content_version = 0; };
+
+MessageType PeekType(base::span<const uint8_t> frame);
