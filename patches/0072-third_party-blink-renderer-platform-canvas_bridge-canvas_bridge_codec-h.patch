+  kBlendFunc = 85, kDepthFunc = 86, kPixelStorei = 87, kScissor = 88,
+  kDrawArrays = 90, kDrawElements = 91,
+};
+
+enum class Canvas2DOp : uint32_t {
+  kUnknown = 0,
+  kSave = 1, kRestore = 2, kBeginPath = 3, kClosePath = 4, kFill = 5,
+  kStroke = 6, kClip = 7,
+  kFillRect = 10, kStrokeRect = 11, kClearRect = 12,
+  kFillText = 20, kStrokeText = 21,
+  kMoveTo = 30, kLineTo = 31, kRect = 32, kArc = 33, kArcTo = 34,
+  kQuadraticCurveTo = 35, kBezierCurveTo = 36, kEllipse = 37,
+  kSetTransform = 40, kTransform = 41, kTranslate = 42, kRotate = 43,
+  kScale = 44, kResetTransform = 45,
+  kSetFillStyle = 50, kSetStrokeStyle = 51, kSetLineWidth = 52,
+  kSetFont = 53, kSetTextAlign = 54, kSetTextBaseline = 55,
+  kSetGlobalAlpha = 56, kSetGlobalCompositeOperation = 57,
+  kSetLineCap = 58, kSetLineJoin = 59, kSetMiterLimit = 60,
