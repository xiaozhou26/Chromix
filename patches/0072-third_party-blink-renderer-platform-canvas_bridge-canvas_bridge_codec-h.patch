+std::vector<uint8_t> Encode(const CreateWebGLMessage&);
+std::vector<uint8_t> Encode(const WebGLOpMessage&);
+std::vector<uint8_t> Encode(const GetImageDataMessage&);
+std::vector<uint8_t> Encode(const ImageDataMessage&);
+std::optional<HelloMessage> DecodeHello(base::span<const uint8_t>);
+std::optional<WelcomeMessage> DecodeWelcome(base::span<const uint8_t>);
+std::optional<CreateCanvas2DMessage> DecodeCreateCanvas2D(base::span<const uint8_t>);
+std::optional<Canvas2DOpMessage> DecodeCanvas2DOp(base::span<const uint8_t>);
+std::optional<MeasureTextMessage> DecodeMeasureText(base::span<const uint8_t>);
+std::optional<CreateWebGLMessage> DecodeCreateWebGL(base::span<const uint8_t>);
+std::optional<WebGLOpMessage> DecodeWebGLOp(base::span<const uint8_t>);
+std::optional<GetImageDataMessage> DecodeGetImageData(base::span<const uint8_t>);
+std::optional<ImageDataMessage> DecodeImageData(base::span<const uint8_t>);
