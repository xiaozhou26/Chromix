+namespace {
+uint32_t EnsureBridgeCanvas(canvas_bridge::CanvasBridgeClient* bridge,
+                            uint32_t& canvas_id,
+                            int width,
+                            int height) {
+  if (canvas_id == 0) {
+    canvas_id = bridge->AllocateCanvasId();
+    canvas_bridge::CreateCanvas2DMessage create;
+    create.canvas_id = canvas_id;
+    create.width = static_cast<uint32_t>(std::max(width, 0));
+    create.height = static_cast<uint32_t>(std::max(height, 0));
+    bridge->Send(canvas_bridge::Encode(create));
+  }
+  return canvas_id;
+}
+}  // namespace
+
+void BaseRenderingContext2D::RecordBridgeOp(
+    uint32_t op,
+    const std::string& str,
+    const std::vector<double>& args) {
+  auto* bridge = canvas_bridge::CanvasBridgeClient::Get();
+  if (!bridge || !bridge->Connected())
+    return;
+  canvas_bridge::Canvas2DOpMessage message;
+  message.canvas_id =
+      EnsureBridgeCanvas(bridge, bridge_canvas_id_, Width(), Height());
+  message.op = op;
+  message.str_arg = str;
+  message.args = args;
+  bridge->Send(canvas_bridge::Encode(message));
+  switch (static_cast<canvas_bridge::Canvas2DOp>(op)) {
+    case canvas_bridge::Canvas2DOp::kFill:
+    case canvas_bridge::Canvas2DOp::kStroke:
+    case canvas_bridge::Canvas2DOp::kFillRect:
+    case canvas_bridge::Canvas2DOp::kStrokeRect:
+    case canvas_bridge::Canvas2DOp::kClearRect:
+    case canvas_bridge::Canvas2DOp::kFillText:
+    case canvas_bridge::Canvas2DOp::kStrokeText:
+      bridge->BumpVersion(message.canvas_id);
+      bridge->MaybePrefetch(message.canvas_id, static_cast<uint32_t>(Width()),
+                            static_cast<uint32_t>(Height()));
+      break;
+    default:
+      break;
+  }
+}
+
+bool BaseRenderingContext2D::ReadBridgePixels(std::vector<uint8_t>* out,
+                                              int width,
+                                              int height) {
+  auto* bridge = canvas_bridge::CanvasBridgeClient::Get();
+  if (!bridge || !bridge->Connected() || bridge_canvas_id_ == 0 || width <= 0 ||
+      height <= 0) {
+    return false;
+  }
+  auto pixels = bridge->GetImageDataCacheFirst(
+      bridge_canvas_id_, 0, 0, static_cast<uint32_t>(width),
+      static_cast<uint32_t>(height));
+  if (!pixels || pixels->size() != static_cast<size_t>(width) * height * 4)
+    return false;
+  *out = std::move(*pixels);
+  return true;
+}
