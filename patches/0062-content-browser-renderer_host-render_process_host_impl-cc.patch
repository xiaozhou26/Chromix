+  static const char* const kUxrStartupSwitches[] = {
+      "uxr-languages", "uxr-fingerprint-off", "uxr-ua-brand",
+      "uxr-ua-brand-version", "uxr-ua-full-version", "uxr-ua-os",
+      "uxr-ua-platform", "uxr-ua-platform-version", "uxr-ua-arch",
+      "uxr-ua-bitness", "uxr-ua-model", "uxr-ua-wow64"};
+  command_line->CopySwitchesFrom(browser_command_line, kUxrStartupSwitches);
+
+  // V8 cannot read the renderer's base::UxrConfig during flag initialization.
+  if (browser_command_line.HasSwitch(
+          "uxr-devtools-runtime-suppression")) {
+    AppendToCommaSeparatedSwitch(
+        command_line, blink::switches::kJavaScriptFlags,
+        "--uxr-devtools-runtime-suppression");
+  }
+
   // Pass on the browser locale.
   const std::string locale =
