+// Only RGBA8 readbacks have a fixed four-byte pixel layout here.
+void ApplyWebGLReadbackNoise(uint8_t* data, GLsizei width, GLsizei height,
+                             uint64_t seed) {
+  if (!data || width <= 0 || height <= 0)
+    return;
+  for (GLsizei y = 0; y < height; ++y) {
+    for (GLsizei x = 0; x < width; ++x) {
+      uint8_t* pixel = data +
+          (static_cast<size_t>(y) * static_cast<size_t>(width) +
+           static_cast<size_t>(x)) * 4;
+      for (int channel = 0; channel < 3; ++channel) {
+        uint32_t z = static_cast<uint32_t>(seed) ^
+                     (static_cast<uint32_t>(x) * 374761393u) ^
+                     (static_cast<uint32_t>(y) * 668265263u) ^
+                     (static_cast<uint32_t>(channel) * 0x9e3779b9u) ^
+                     (static_cast<uint32_t>(pixel[channel]) * 2654435761u);
+        z ^= z >> 16;
+        z *= 0x85ebca6bu;
+        z ^= z >> 13;
+        z *= 0xc2b2ae35u;
+        z ^= z >> 16;
+        const int value = static_cast<int>(pixel[channel]) +
+                          ((z & 1u) ? 1 : -1);
+        pixel[channel] = static_cast<uint8_t>(std::clamp(value, 0, 255));
+      }
+    }
+  }
+}
