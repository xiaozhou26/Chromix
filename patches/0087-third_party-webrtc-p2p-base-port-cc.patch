+bool SetForcedWebRtcSrflxIP(absl::string_view ip) {
+  IPAddress parsed;
+  const bool valid = IPFromString(ip, &parsed) && parsed.family() == AF_INET &&
+                     parsed.v4AddressAsHostOrderInteger() != 0;
+  ForcedSrflxStore().store(
+      valid ? static_cast<uint64_t>(parsed.v4AddressAsHostOrderInteger()) + 1
+            : 0,
+      std::memory_order_release);
+  return valid;
+}
+
+std::optional<IPAddress> ForcedWebRtcSrflxIP() {
+  const uint64_t encoded_address =
+      ForcedSrflxStore().load(std::memory_order_acquire);
+  return encoded_address
+             ? std::optional<IPAddress>(IPAddress(static_cast<uint32_t>(
+                   encoded_address - 1)))
+             : std::nullopt;
+}
