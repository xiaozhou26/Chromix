+bool UseWindowsSpeechVoiceTable() {
+  const auto& config = base::UxrConfig::GetInstance();
+  if (!config.Has("uxr-voices") || config.Get("uxr-fingerprint-off") == "true")
+    return false;
+  const std::string platform = base::ToLowerASCII(config.Get("uxr-platform"));
+  const std::string ua_platform = base::ToLowerASCII(config.Get("uxr-ua-platform"));
+  const bool windows = platform == "win32" || platform == "windows" || ua_platform == "windows";
+#if BUILDFLAG(IS_WIN)
+  if (!windows && (!platform.empty() || !ua_platform.empty()))
+    return false;
+#else
+  if (!windows)
+    return false;
+#endif
+  const std::string value = config.Get("uxr-voices");
+  if (value == "false" || value == "0" || value == "off")
+    return false;
+#if BUILDFLAG(IS_WIN)
+  // A genuine Windows host already has a SAPI inventory and matching backend.
+  // Keep it for the default mode; an explicit locale remains a test override.
+  if (value.empty() || value == "true" || value == "1")
+    return false;
+#endif
+  return true;
+}
+
+Vector<mojom::blink::SpeechSynthesisVoicePtr> WindowsSpeechVoiceTable() {
+  const auto& config = base::UxrConfig::GetInstance();
+  std::string language = config.Get("uxr-voices");
+  if (language.empty() || language == "true" || language == "1")
+    language = config.Get("uxr-languages");
+  language = base::ToLowerASCII(language.substr(0, language.find(',')));
+  struct Voice { const char* language; const char* name; };
+  // Baseline desktop SAPI language-pack combinations, not fabricated installed
+  // voices. Cross-OS table mode does not install a Windows synthesis engine.
+  constexpr Voice kLocalizedVoices[] = {
+      {"zh-cn", "Microsoft Huihui Desktop - Chinese (Simplified, PRC)"},
+      {"zh-tw", "Microsoft Hanhan Desktop - Chinese (Taiwan)"},
+      {"en-gb", "Microsoft Hazel Desktop - English (Great Britain)"},
+      {"de-de", "Microsoft Hedda Desktop - German"},
+      {"fr-fr", "Microsoft Hortense Desktop - French"},
+      {"es-es", "Microsoft Helena Desktop - Spanish (Spain)"},
+      {"it-it", "Microsoft Elsa Desktop - Italian (Italy)"},
+      {"ja-jp", "Microsoft Haruka Desktop - Japanese"},
+      {"ko-kr", "Microsoft Heami Desktop - Korean"},
+      {"pt-br", "Microsoft Maria Desktop - Portuguese (Brazil)"},
+      {"ru-ru", "Microsoft Irina Desktop - Russian"},
+      {"pl-pl", "Microsoft Paulina Desktop - Polish"},
+  };
+  Vector<mojom::blink::SpeechSynthesisVoicePtr> voices;
+  const auto add = [&](const char* name, std::string tag) {
+    // BCP47 language lower-case / region upper-case, matching native SAPI.
+    const auto dash = tag.find('-');
+    if (dash != std::string::npos)
+      tag = tag.substr(0, dash + 1) + base::ToUpperASCII(tag.substr(dash + 1));
+    voices.push_back(mojom::blink::SpeechSynthesisVoice::New(
+        String(name), String(name), String(tag.c_str()), true, voices.empty()));
+  };
+  for (const auto& voice : kLocalizedVoices) {
+    if (language == voice.language || language.starts_with(std::string(voice.language) + "-")) {
+      add(voice.name, voice.language);
+      break;
+    }
+  }
+  add("Microsoft David Desktop - English (United States)", "en-us");
+  add("Microsoft Zira Desktop - English (United States)", "en-us");
+  return voices;
+}
+
+}  // namespace
