 #include "base/system/sys_info.h"
 
+#include <cstdlib>  // UXR
+#include "base/command_line.h"  // UXR
+#include "base/uxr_config.h"
+#include "base/strings/string_number_conversions.h"
+
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  // Public explicit/default overrides do not require synthetic-test mode.
+  // This reports a logical core budget; it does not pin host CPU resources.
+  if (base::UxrConfig::GetInstance().Has("uxr-hw-concurrency")) {
+    int v = 0;  // UXR P1-A: StringToInt + clamp [1,128]
+    if (base::StringToInt(
+            base::UxrConfig::GetInstance().Get("uxr-hw-concurrency"), &v) &&
+        v > 0)
+      return static_cast<unsigned>(v > 128 ? 128 : v);
+  }
+  // Independent randomized hardware pools remain explicit test fixtures.
+  {
+    const int ph_pool =
+        base::UxrConfig::GetInstance().GetSeededHwConcurrency();
+    if (ph_pool > 0)
+      return static_cast<unsigned>(ph_pool);
+  }
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }
 
