+  float sampleRate() const {
+    // UXR: persona output-device sample rate. The host audio device (or
+    // headless fallback) leaks its sample rate here — Windows desktops run
+    // 48000, some Macs 44100. Pin to the persona platform when set.
+    double ph_r = 0.0;
+    if (base::StringToDouble(
+            base::UxrConfig::GetInstance().Get("uxr-audio-samplerate"),
+            &ph_r) &&
+        ph_r > 0.0) {
+      return static_cast<float>(ph_r);
+    }
+    return destination_handler_->SampleRate();
+  }
