@@ -389,6 +391,48 @@ void MediaRecorder::requestData(ExceptionState& exception_state) {
 
 bool MediaRecorder::isTypeSupported(ExecutionContext* context,
                                     const String& type) {
+  // UXR: persona codec matrix. The native answer reflects the host's
+  // encoder availability (a Linux build answers differently than the claimed
+  // desktop-Chrome persona). With uxr-codec-matrix set, common queries are
+  // answered from a fixed desktop-Chrome declaration table; anything the table
+  // does not know falls through to the native answer. NOTE: this pins the
+  // *declaration* surface; actually encoding a type the host cannot encode
+  // will still fail at start() — the persona flag is opt-in.
+  {
+    std::string ph_matrix = base::UxrConfig::GetInstance().Get("uxr-codec-matrix");
+    if (!ph_matrix.empty()) {
+      const std::string t = type.LowerASCII().Utf8();
+      const std::string container = t.substr(0, t.find(';'));
+      const size_t codecs_at = t.find("codecs=");
+      const std::string codecs =
+          codecs_at == std::string::npos ? "" : t.substr(codecs_at + 7);
+      bool known_container = true;
+      bool supported = false;
+      if (container == "video/webm" || container == "audio/webm") {
+        supported = codecs.empty() || codecs.find("vp8") != std::string::npos ||
+                    codecs.find("vp9") != std::string::npos ||
+                    codecs.find("opus") != std::string::npos ||
+                    (container == "video/webm" &&
+                     (codecs.find("h264") != std::string::npos ||
+                      codecs.find("avc1") != std::string::npos));
+      } else if (container == "video/mp4" || container == "audio/mp4") {
+        supported = codecs.empty() || codecs.find("avc1") != std::string::npos ||
+                    codecs.find("avc3") != std::string::npos ||
+                    codecs.find("vp9") != std::string::npos ||
+                    codecs.find("mp4a.40") != std::string::npos ||
+                    codecs.find("aac") != std::string::npos;
+      } else if (container == "video/x-matroska") {
+        supported = codecs.empty() || codecs.find("avc1") != std::string::npos ||
+                    codecs.find("h264") != std::string::npos;
+      } else {
+        known_container = false;  // not in the persona table: native answer
+      }
+      if (known_container) {
+        return supported;
+      }
+    }
+  }
+
   MediaRecorderHandler* handler = MakeGarbageCollected<MediaRecorderHandler>(
       context->GetTaskRunner(TaskType::kInternalMediaRealTime),
       KeyFrameRequestProcessor::Configuration());
