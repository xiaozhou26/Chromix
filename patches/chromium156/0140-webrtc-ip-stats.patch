diff --git a/third_party/blink/renderer/modules/peerconnection/rtc_stats_report.cc b/third_party/blink/renderer/modules/peerconnection/rtc_stats_report.cc
--- a/third_party/blink/renderer/modules/peerconnection/rtc_stats_report.cc
+++ b/third_party/blink/renderer/modules/peerconnection/rtc_stats_report.cc
@@ -50,6 +50,7 @@
 #include "third_party/blink/renderer/modules/mediastream/user_media_client.h"
 #include "third_party/blink/renderer/platform/bindings/script_state.h"
 #include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/peerconnection/fingerprint_ip.h"
 #include "third_party/blink/renderer/platform/peerconnection/rtc_stats.h"
 #include "third_party/blink/renderer/platform/peerconnection/webrtc_util.h"
 #include "third_party/blink/renderer/platform/wtf/casting.h"
@@ -537,6 +538,16 @@
   // Non-standard and obsolete stats.
   SET_STAT(webrtc_stat.is_remote, v8_stat->setIsRemote);
   SET_STAT(webrtc_stat.ip, v8_stat->setIp);
+  if (std::string_view(webrtc_stat.type()) == "local-candidate" &&
+      (!webrtc_stat.candidate_type.has_value() || *webrtc_stat.candidate_type != "relay")) {
+    const std::string ip = FingerprintWebRtcIp();
+    if (!ip.empty()) {
+      if (webrtc_stat.address.has_value())
+        v8_stat->setAddress(String::FromUtf8(RewriteFingerprintAddress(*webrtc_stat.address, ip)));
+      if (webrtc_stat.ip.has_value())
+        v8_stat->setIp(String::FromUtf8(RewriteFingerprintAddress(*webrtc_stat.ip, ip)));
+    }
+  }
   return v8_stat;
 }
 
