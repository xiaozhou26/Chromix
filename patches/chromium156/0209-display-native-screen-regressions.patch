+class DisplayOrientationEventListener final : public NativeEventListener {
+ public:
+  explicit DisplayOrientationEventListener(base::OnceClosure callback)
+      : callback_(std::move(callback)) {}
+
+  void Invoke(ExecutionContext*, Event*) override {
+    ++count_;
+    if (callback_) {
+      std::move(callback_).Run();
+    }
+  }
+
+  int Count() const { return count_; }
+
+ private:
+  base::OnceClosure callback_;
+  int count_ = 0;
+};
