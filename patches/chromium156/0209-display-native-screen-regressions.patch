+  display::ScreenInfo initial_screen = widget->GetOriginalScreenInfo();
+  initial_screen.orientation_type =
+      display::mojom::ScreenOrientation::kLandscapePrimary;
+  initial_screen.orientation_angle = 90;
+  widget->UpdateScreenInfo(display::ScreenInfos(initial_screen));
+  test::RunPendingTasks();
+  WebView().SetScreenOrientationOverrideForTesting(
+      display::mojom::blink::ScreenOrientation::kPortraitPrimary);
+  test::RunPendingTasks();
+  Window().addEventListener(event_type_names::kOrientationchange, listener,
+                            false);
+  const auto native = widget->GetOriginalScreenInfos();
+  DeviceEmulationParams params;
+  params.screen_size = gfx::Size(1920, 1080);
+  params.view_size = gfx::Size(800, 600);
+  params.device_scale_factor = 1.25f;
+  params.screen_orientation_type =
+      display::mojom::ScreenOrientation::kPortraitSecondary;
+  params.screen_orientation_angle = 180;
+  widget->EnableDeviceEmulation(
+      params, mojom::blink::DeviceEmulationCacheBehavior::kClearCache);
+  events_are(0);
+  WebView().SetScreenOrientationOverrideForTesting(std::nullopt);
+  events_are(1);
+  widget->RefreshScreenInfo();
+  events_are(1);
+  EXPECT_EQ(native, widget->GetOriginalScreenInfos());
+  EXPECT_FLOAT_EQ(1.25f, widget->GetScreenInfo().device_scale_factor);
+  EXPECT_EQ(gfx::Rect(1920, 1080), widget->GetScreenInfo().rect);
+  params.screen_orientation_angle = 0;
+  params.screen_orientation_type =
+      display::mojom::ScreenOrientation::kPortraitPrimary;
+  widget->EnableDeviceEmulation(
+      params, mojom::blink::DeviceEmulationCacheBehavior::kClearCache);
+  events_are(2);
+  widget->DisableDeviceEmulation();
+  events_are(3);
+  widget->RefreshScreenInfo();
+  events_are(3);
+}
