+  native_screen.rect = gfx::Rect(800, 600);
+  native_screen.orientation_type =
+      display::mojom::ScreenOrientation::kLandscapePrimary;
+  display::ScreenInfo effective = native_screen;
+  effective.device_scale_factor = 1.25f;
+  effective.rect = gfx::Rect(1920, 1080);
+  effective.orientation_type =
+      display::mojom::ScreenOrientation::kPortraitPrimary;
+  VisualProperties properties;
+  properties.screen_infos = display::ScreenInfos(native_screen);
+  properties.emulated_screen_infos = display::ScreenInfos(effective);
+  properties.new_size_device_px = gfx::Size(300, 150);
+  properties.visible_viewport_size_device_px = gfx::Size(800, 600);
+  widget->ApplyVisualProperties(properties);
+  for (auto override :
+       {display::mojom::blink::ScreenOrientation::kLandscapePrimary,
+        display::mojom::blink::ScreenOrientation::kPortraitSecondary}) {
+    WebView().SetScreenOrientationOverrideForTesting(override);
+    EXPECT_EQ(properties.screen_infos, widget->GetOriginalScreenInfos());
+    EXPECT_FLOAT_EQ(1.f,
+                    widget->LayerTreeHostForTesting()->device_scale_factor());
+    EXPECT_EQ(gfx::PointF(37, 19),
