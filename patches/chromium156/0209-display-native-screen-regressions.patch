+TEST_F(WebFrameWidgetSimTest, EmulatedScreenInitialNestedPropagationAndClear) {
+  SimRequest request("https://example.com/test.html", "text/html");
+  LoadURL("https://example.com/test.html");
+  request.Complete(R"HTML(
+      <iframe srcdoc='<iframe srcdoc="plain text"></iframe>'></iframe>
+      )HTML");
+  base::RunLoop().RunUntilIdle();
+  auto* widget = WebView().MainFrameViewWidget();
+  const auto native_screens = widget->GetOriginalScreenInfos();
+  DeviceEmulationParams params;
+  params.screen_size = gfx::Size(1920, 1080);
+  params.view_size = gfx::Size(800, 600);
+  params.device_scale_factor = 1.25f;
+  widget->EnableDeviceEmulation(
+      params, mojom::blink::DeviceEmulationCacheBehavior::kClearCache);
+  auto* grandchild = WebView().MainFrame()->FirstChild()->FirstChild();
+  ASSERT_TRUE(grandchild);
+  frame_test_helpers::SwapRemoteFrame(grandchild,
+                                      frame_test_helpers::CreateRemote());
+  auto* remote =
+      To<WebRemoteFrameImpl>(WebView().MainFrame()->FirstChild()->FirstChild());
+  auto check = [&](bool emulated) {
+    const auto& properties =
+        remote->GetFrame()->GetPendingVisualPropertiesForTesting();
+    EXPECT_EQ(native_screens, properties.screen_infos);
+    EXPECT_EQ(emulated, properties.emulated_screen_infos.has_value());
+    if (emulated) {
+      EXPECT_EQ(widget->GetScreenInfos(), *properties.emulated_screen_infos);
+    }
+  };
+  check(true);
+  params.device_scale_factor = 2.f;
+  widget->EnableDeviceEmulation(
+      params, mojom::blink::DeviceEmulationCacheBehavior::kClearCache);
+  check(true);
+  widget->DisableDeviceEmulation();
+  check(false);
+  widget->EnableDeviceEmulation(
+      params, mojom::blink::DeviceEmulationCacheBehavior::kClearCache);
+  check(true);
+  remote->Detach();
+}
