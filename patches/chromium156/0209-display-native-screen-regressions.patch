+TEST_F(WebFrameWidgetImplRemoteFrameSimTest,
+       EmulatedScreenMojoRoundTripAndClear) {
+  display::ScreenInfo native_screen;
+  display::ScreenInfo emulated_screen;
+  emulated_screen.device_scale_factor = 1.25f;
+  emulated_screen.rect = gfx::Rect(1920, 1080);
+  FrameVisualProperties frame;
+  viz::ParentLocalSurfaceIdAllocator allocator;
+  allocator.GenerateId();
+  frame.local_surface_id = allocator.GetCurrentLocalSurfaceId();
+  frame.screen_infos = display::ScreenInfos(native_screen);
+  frame.emulated_screen_infos = display::ScreenInfos(emulated_screen);
+  FrameVisualProperties frame_copy(frame);
+  EXPECT_EQ(frame.emulated_screen_infos, frame_copy.emulated_screen_infos);
+  FrameVisualProperties empty_frame;
+  FrameVisualProperties empty_copy(empty_frame);
+  EXPECT_FALSE(empty_copy.emulated_screen_infos);
+  empty_copy = frame;
+  EXPECT_EQ(frame.emulated_screen_infos, empty_copy.emulated_screen_infos);
+  frame.emulated_screen_infos->mutable_current().device_scale_factor = 2.f;
+  EXPECT_FLOAT_EQ(
+      1.25f, frame_copy.emulated_screen_infos->current().device_scale_factor);
+  frame_copy = frame;
+  EXPECT_EQ(frame.emulated_screen_infos, frame_copy.emulated_screen_infos);
+  empty_copy = empty_frame;
+  EXPECT_FALSE(empty_copy.emulated_screen_infos);
+  EXPECT_EQ(empty_frame.screen_infos, empty_copy.screen_infos);
+  FrameVisualProperties decoded_frame;
+  ASSERT_TRUE(
+      mojo::test::SerializeAndDeserialize<mojom::blink::FrameVisualProperties>(
+          frame_copy, decoded_frame));
+  EXPECT_EQ(frame.screen_infos, decoded_frame.screen_infos);
+  EXPECT_EQ(frame.emulated_screen_infos, decoded_frame.emulated_screen_infos);
+
+  VisualProperties widget;
+  widget.screen_infos = decoded_frame.screen_infos;
+  widget.emulated_screen_infos = decoded_frame.emulated_screen_infos;
+  VisualProperties widget_copy(widget);
+  EXPECT_EQ(widget, widget_copy);
+  widget.emulated_screen_infos->mutable_current().device_scale_factor = 3.f;
+  EXPECT_FALSE(widget == widget_copy);
+  widget_copy = widget;
+  EXPECT_EQ(widget, widget_copy);
+  VisualProperties empty_widget;
+  widget_copy = empty_widget;
+  EXPECT_FALSE(widget_copy.emulated_screen_infos);
+  VisualProperties decoded_widget;
+  ASSERT_TRUE(
+      mojo::test::SerializeAndDeserialize<mojom::blink::VisualProperties>(
+          widget, decoded_widget));
+  EXPECT_EQ(widget, decoded_widget);
+  widget.emulated_screen_infos.reset();
+  EXPECT_FALSE(widget == decoded_widget);
+  ASSERT_TRUE(
+      mojo::test::SerializeAndDeserialize<mojom::blink::VisualProperties>(
+          widget, decoded_widget));
+  EXPECT_FALSE(decoded_widget.emulated_screen_infos);
+  frame.emulated_screen_infos.reset();
+  ASSERT_TRUE(
+      mojo::test::SerializeAndDeserialize<mojom::blink::FrameVisualProperties>(
+          frame, decoded_frame));
+  EXPECT_FALSE(decoded_frame.emulated_screen_infos);
+}
