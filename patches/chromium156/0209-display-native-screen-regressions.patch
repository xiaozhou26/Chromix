+    EXPECT_EQ(override, widget->GetScreenInfo().orientation_type);
+    EXPECT_FLOAT_EQ(1.25f, widget->GetScreenInfo().device_scale_factor);
+    EXPECT_EQ(300, LocalFrameRoot().GetFrame()->DomWindow()->innerWidth());
+  }
+  effective.orientation_angle = 270;
+  properties.emulated_screen_infos = display::ScreenInfos(effective);
+  widget->ApplyVisualProperties(properties);
