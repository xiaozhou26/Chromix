+uint32_t EnsureBridgeWebGL(canvas_bridge::CanvasBridgeClient* bridge,
+                           uint32_t& canvas_id,
+                           int width,
+                           int height) {
+  if (canvas_id == 0) {
+    canvas_id = bridge->AllocateCanvasId();
+    canvas_bridge::CreateWebGLMessage create;
+    create.canvas_id = canvas_id;
+    create.width = static_cast<uint32_t>(std::max(width, 0));
+    create.height = static_cast<uint32_t>(std::max(height, 0));
+    bridge->Send(canvas_bridge::Encode(create));
+  }
+  return canvas_id;
+}
+
+void RecordWebGLOp(uint32_t op,
+                   std::vector<int32_t> ints,
+                   std::vector<double> floats,
+                   uint32_t& canvas_id,
+                   int width,
+                   int height,
+                   std::string str = {},
+                   std::vector<uint8_t> data = {}) {
+  auto* bridge = canvas_bridge::CanvasBridgeClient::Get();
+  if (!bridge || !bridge->Connected())
+    return;
+  canvas_bridge::WebGLOpMessage message;
+  message.canvas_id = EnsureBridgeWebGL(bridge, canvas_id, width, height);
+  message.op = op;
+  message.ints = std::move(ints);
+  message.floats = std::move(floats);
+  message.str = std::move(str);
+  message.data = std::move(data);
+  bridge->Send(canvas_bridge::Encode(message));
+  switch (static_cast<canvas_bridge::WebGLOp>(op)) {
+    case canvas_bridge::WebGLOp::kDrawArrays:
+    case canvas_bridge::WebGLOp::kDrawElements:
+    case canvas_bridge::WebGLOp::kClear:
+      bridge->BumpVersion(message.canvas_id);
+      bridge->MaybePrefetch(message.canvas_id, static_cast<uint32_t>(width),
+                            static_cast<uint32_t>(height));
+      break;
+    default:
+      break;
+  }
+}
+
+void RecordWebGLCreate(uint32_t op,
+                       WebGLObject* object,
+                       uint32_t& counter,
+                       uint32_t& canvas_id,
+                       int width,
+                       int height) {
+  auto* bridge = canvas_bridge::CanvasBridgeClient::Get();
+  if (!bridge || !bridge->Connected())
+    return;
+  object->SetBridgeId(++counter);
+  RecordWebGLOp(op, {static_cast<int32_t>(object->BridgeId())}, {}, canvas_id,
+                width, height);
+}
