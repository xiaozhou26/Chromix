 float ScreenDetailed::devicePixelRatio() const {
   if (!DomWindow())
     return 0.f;
+  if (UxrSingleScreenActive()) {
+    double dpr = 0.0;
+    if (base::StringToDouble(
+            base::UxrConfig::GetInstance().Get("uxr-device-pixel-ratio"),
+            &dpr) &&
+        dpr > 0.0) {
+      return static_cast<float>(dpr);
+    }
+  }
   return GetScreenInfo().device_scale_factor;
 }
 
 String ScreenDetailed::label() const {
   if (!DomWindow())
     return String();
+  if (UxrSingleScreenActive())
+    return String();
   return String::FromUtf8(GetScreenInfo().label);
 }
 
