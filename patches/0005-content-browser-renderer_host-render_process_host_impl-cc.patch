   uint64_t trace_id = base::Token::CreateRandom().high();
   TRACE_EVENT("navigation", "RenderProcessHostImpl::Init",
               perfetto::Flow::Global(trace_id));
+  // Keep the browser's UA and metadata authoritative for network and JS.
+  {
+    base::flat_map<std::string, std::string> uxr_cfg;
+    for (const auto& sw :
+         base::CommandLine::ForCurrentProcess()->GetSwitches()) {
+      if (sw.first.compare(0, 4, "uxr-") == 0) {
+        uxr_cfg[sw.first] =
+            base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(sw.first);
+      }
+    }
+    // Snapshot construction is browser-owned and launch-scoped. Even an empty
+    // native snapshot must arrive before WebKit/isolate initialization.
+    auto& snapshot = base::UxrConfig::GetInstance();
+    CHECK(snapshot.SetAll(uxr_cfg)) << snapshot.ValidationError();
+    uxr_cfg = snapshot.Snapshot();
+    GetRendererInterface()->SetUxrConfig(
+        std::move(uxr_cfg), base::UxrConfig::kSchemaVersion);
+  }
   GetRendererInterface()->InitializeRenderer(
