@@ -433,6 +434,24 @@ V8NotificationPermission Notification::permission(ExecutionContext* context) {
     }
   }
 
+  // FORTRESS: persona notification permission. Historically headless builds
+  // answered "denied" here while Permissions.query said "default" — the
+  // mismatch is a documented headless tell. Pin both surfaces to the persona
+  // (see the permissions-module patch for the query() side).
+  {
+    std::string ph_np =
+        base::UxrConfig::GetInstance().Get("uxr-notification-permission");
+    if (!ph_np.empty()) {
+      if (ph_np == "granted") {
+        return V8NotificationPermission(V8NotificationPermission::Enum::kGranted);
+      }
+      if (ph_np == "denied") {
+        return V8NotificationPermission(V8NotificationPermission::Enum::kDenied);
+      }
+      return V8NotificationPermission(V8NotificationPermission::Enum::kDefault);
+    }
+  }
