diff --git a/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc b/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
index 9d155705c1..b8f0e0b8f0 100644
--- a/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
+++ b/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
@@ -4,6 +4,9 @@
 
 #include "third_party/blink/renderer/modules/webgpu/gpu_adapter_info.h"
 
+#include "base/uxr_config.h"
+#include "components/ungoogled/persona_profile.h"
+
 #include "third_party/blink/renderer/modules/webgpu/gpu_memory_heap_info.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_subgroup_matrix_config.h"
 
@@ -34,7 +37,47 @@ GPUAdapterInfo::GPUAdapterInfo(const String& vendor,
       type_(type),
       d3d_shader_model_(d3d_shader_model),
       vk_driver_version_(vk_driver_version),
-      power_preference_(power_preference) {}
+      power_preference_(power_preference) {
+  // Identity overrides cannot turn a software adapter into hardware.
+  if (is_fallback_adapter_)
+    return;
+  const auto& config = base::UxrConfig::GetInstance();
+  if (config.Get("uxr-fingerprint-off") == "true" ||
+      (config.Get("uxr-synthetic-device-tests") != "true" &&
+       config.Get("uxr-fingerprint-enabled") != "true" &&
+       !config.Has("uxr-webgl-vendor") && !config.Has("uxr-webgl-renderer")))
+    return;
+  const auto& persona = ungoogled::CurrentPersona();
+  const bool explicit_vendor = config.Has("uxr-webgpu-vendor") &&
+      !config.Get("uxr-webgpu-vendor").empty();
+  const bool explicit_architecture =
+      config.Has("uxr-webgpu-architecture") &&
+      !config.Get("uxr-webgpu-architecture").empty();
+  const bool explicit_identity = explicit_vendor && explicit_architecture;
+  const bool use_template = !persona.webgl_real &&
+      !persona.webgpu_vendor.empty() &&
+      !persona.webgpu_architecture.empty();
+  const bool use_custom = !persona.webgl_real && persona.webgl_identity_explicit;
+  if (!explicit_identity && !use_template && !use_custom)
+    return;
+
+  // Custom model names cannot certify architecture/device/driver values.
+  // Use empty fields instead of combining them with native identity metadata.
+  vendor_ = explicit_identity
+      ? String(config.Get("uxr-webgpu-vendor").c_str())
+      : String(persona.webgpu_vendor.c_str());
+  architecture_ = explicit_identity
+      ? String(config.Get("uxr-webgpu-architecture").c_str())
+      : String(persona.webgpu_architecture.c_str());
+  const std::string webgpu_description =
+      config.Get("uxr-webgpu-description");
+  if (explicit_identity && !webgpu_description.empty())
+    description_ = String(webgpu_description.c_str());
+  else
+    description_ = String();
+  device_ = String();
+  driver_ = String();
+}
 
