 V8OrientationType ScreenOrientation::type() const {
+  // UXR: persona screen orientation. Desktop Chrome is landscape-primary
+  // with angle 0; a headless host reporting anything else contradicts the
+  // desktop persona.
+  std::string ph_o = base::UxrConfig::GetInstance().Get("uxr-screen-orientation");
+  if (!ph_o.empty()) {
+    if (ph_o == "portrait-primary") {
+      return V8OrientationType(V8OrientationType::Enum::kPortraitPrimary);
+    }
+    if (ph_o == "portrait-secondary") {
+      return V8OrientationType(V8OrientationType::Enum::kPortraitSecondary);
+    }
+    if (ph_o == "landscape-secondary") {
+      return V8OrientationType(V8OrientationType::Enum::kLandscapeSecondary);
+    }
+    return V8OrientationType(V8OrientationType::Enum::kLandscapePrimary);
+  }
   return V8OrientationType(OrientationTypeToV8Enum(type_));
 }
 
 uint16_t ScreenOrientation::angle() const {
+  {  // UXR: persona orientation angle (0 for any standard desktop layout)
+    int ph_a = -1;
+    if (base::StringToInt(
+            base::UxrConfig::GetInstance().Get("uxr-screen-orientation-angle"),
+            &ph_a) &&
+        ph_a >= 0) {
+      return static_cast<uint16_t>(ph_a);
+    }
+  }
   return angle_;
 }
 
