@@ -72,6 +74,32 @@ constexpr uint64_t UndefinedLimitValue<uint64_t>() {
 
 GPUSupportedLimits::GPUSupportedLimits(const ComboLimits& limits) {
   limits.UnlinkedCopyTo(&limits_);
+  // FORTRESS: persona WebGPU limits. Dawn reports the host adapter's limits,
+  // which contradict the claimed persona GPU. Keys follow
+  // uxr-webgpu-limit-<member> (e.g. uxr-webgpu-limit-maxTextureDimension2D);
+  // an all-lowercase spelling is accepted as well. Only values explicitly set
+  // are overridden; everything else keeps the native limit.
+  {
+    base::UxrConfig& ph_cfg = base::UxrConfig::GetInstance();
+    const std::string ph_prefix = "uxr-webgpu-limit-";
+#define X_UXR(name)                                                        \
+    {                                                                      \
+      const std::string ph_member = ph_prefix + #name;                     \
+      std::string ph_lower = ph_member;                                    \
+      for (char& ph_c : ph_lower) {                                        \
+        if (ph_c >= 'A' && ph_c <= 'Z') {                                  \
+          ph_c = static_cast<char>(ph_c - 'A' + 'a');                      \
+        }                                                                  \
+      }                                                                    \
+      uint64_t ph_v = 0;                                                   \
+      if (base::StringToUint64(ph_cfg.Get(ph_member), &ph_v) ||            \
+          base::StringToUint64(ph_cfg.Get(ph_lower), &ph_v)) {             \
+        limits_.name = static_cast<decltype(limits_.name)>(ph_v);          \
+      }                                                                    \
+    }
+    SUPPORTED_LIMITS(X_UXR)
+#undef X_UXR
+  }
 }
 
