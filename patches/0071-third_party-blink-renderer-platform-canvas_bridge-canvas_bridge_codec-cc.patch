+  ImageDataMessage m;
+  m.canvas_id = r.U32();
+  m.width = r.U32();
+  m.height = r.U32();
+  m.pixels = r.Bytes();
+  bool core_ok = r.ok();
+  m.content_version = r.U32();  // optional trailing field (0 if absent)
+  return core_ok ? std::optional<ImageDataMessage>(std::move(m)) : std::nullopt;
+}
