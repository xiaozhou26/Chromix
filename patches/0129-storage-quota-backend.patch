+// Launch-local override shared by estimation, bucket allocation and writes.
+// Usage, per-bucket caps, disk exhaustion and explicit DevTools overrides stay
+// native. The switch is absent in --fingerprint=off mode.
+std::optional<int64_t> FingerprintStorageQuotaBytes() {
+  const std::string value = base::CommandLine::ForCurrentProcess()->
+      GetSwitchValueASCII("uxr-storage-quota");
+  uint64_t megabytes = 0;
+  constexpr uint64_t kMiB = 1024 * 1024;
+  if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos ||
+      !base::StringToUint64(value, &megabytes) ||
+      megabytes > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) / kMiB)
+    return std::nullopt;
+  return static_cast<int64_t>(megabytes * kMiB);
+}
