+bool IsValidCanvasBridgeEndpoint(const std::string& endpoint) {
+  std::string_view value(endpoint);
+  if (value.starts_with("ws://")) {
+    value.remove_prefix(5);
+  } else if (value.starts_with("http://")) {
+    value.remove_prefix(7);
+  } else if (value.find("://") != std::string_view::npos) {
+    return false;
+  }
+  if (value.empty() || value.find_first_of("\r\n\t @") !=
+                           std::string_view::npos) {
+    return false;
+  }
+  const size_t slash = value.find('/');
+  const std::string_view authority = value.substr(0, slash);
+  std::string_view host;
+  std::string_view port;
+  if (authority.empty()) {
+    return false;
+  }
+  if (authority.front() == '[') {
+    const size_t close = authority.find(']');
+    if (close == std::string_view::npos || close + 1 >= authority.size() ||
+        authority[close + 1] != ':') {
+      return false;
+    }
+    host = authority.substr(1, close - 1);
+    port = authority.substr(close + 2);
+  } else {
+    const size_t colon = authority.rfind(':');
+    if (colon == std::string_view::npos || authority.find(':') != colon) {
+      return false;
+    }
+    host = authority.substr(0, colon);
+    port = authority.substr(colon + 1);
+  }
+  int parsed_port = 0;
+  return !host.empty() && !port.empty() &&
+         base::StringToInt(port, &parsed_port) && parsed_port > 0 &&
+         parsed_port <= 65535;
+}
