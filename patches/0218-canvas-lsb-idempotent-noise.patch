diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
--- a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
@@ -800,16 +800,20 @@ ImageData* BaseRenderingContext2D::getImageDataInternal(
             for (uint32_t ch = 0; ch < 3; ++ch) {
               const size_t index = ph_ct == kBGRA_8888_SkColorType ? 2 - ch : ch;
               const uint32_t v = ph_pixel[index];
+              // 0218: LSB-forcing noise. Idempotent and independent of the
+              // pixel value, so every readback path (getImageData, toDataURL,
+              // putImageData round trips, drawImage copies) yields identical
+              // bytes for a given canvas position. The former value-keyed +/-1
+              // perturbation made getImageData and toDataURL disagree and was
+              // detectable via getImageData -> putImageData -> toDataURL.
               uint32_t z = ph_seed ^ (ax * 374761393u) ^ (ay * 668265263u) ^
-                           (ch * 0x9e3779b9u) ^ (v * 2654435761u);
+                           (ch * 0x9e3779b9u);
               z ^= z >> 16;
               z *= 0x85ebca6bu;
               z ^= z >> 13;
               z *= 0xc2b2ae35u;
               z ^= z >> 16;
-              const int nv = static_cast<int>(v) + ((z & 1u) ? 1 : -1);
-              ph_pixel[index] =
-                  static_cast<uint8_t>(nv < 0 ? 0 : (nv > 255 ? 255 : nv));
+              ph_pixel[index] = static_cast<uint8_t>((v & 0xFEu) | (z & 1u));
             }
           }
         }
diff --git a/third_party/blink/renderer/platform/graphics/image_data_buffer.cc b/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
--- a/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
+++ b/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
@@ -95,17 +95,19 @@ bool UxrCopyAndNoiseEncodeBuffer(SkPixmap& pm, sk_sp<SkImage>& retained_image) {
       for (uint32_t ch = 0; ch < 3; ++ch) {
         const size_t index = ct == kBGRA_8888_SkColorType ? 2 - ch : ch;
         const uint32_t v = pixel[index];
+        // 0218: LSB-forcing noise, keyed on (seed, position, channel) only.
+        // Idempotent and cross-channel consistent with the getImageData path
+        // (same absolute position semantics): putImageData round trips and
+        // drawImage copies of already-noised pixels stay byte-identical.
         uint32_t z = seed ^ (static_cast<uint32_t>(x) * 374761393u) ^
                      (static_cast<uint32_t>(y) * 668265263u) ^
-                     (ch * 0x9e3779b9u) ^ (v * 2654435761u);
+                     (ch * 0x9e3779b9u);
         z ^= z >> 16;
         z *= 0x85ebca6bu;
         z ^= z >> 13;
         z *= 0xc2b2ae35u;
         z ^= z >> 16;
-        const int nv = static_cast<int>(v) + ((z & 1u) ? 1 : -1);
-        pixel[index] =
-            static_cast<uint8_t>(nv < 0 ? 0 : (nv > 255 ? 255 : nv));
+        pixel[index] = static_cast<uint8_t>((v & 0xFEu) | (z & 1u));
       }
     }
   }
