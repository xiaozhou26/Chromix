+struct WebGLGPU {
+  const char* vendor;
+  const char* renderer;
+  const char* webgpu_vendor;
+  const char* webgpu_architecture;
+  unsigned weight;
+};
+
+// Platform-compatible identity templates, not measured complete devices or
+// market-share weights. Explicit strings override the chosen tuple below.
+// Architecture tokens follow Dawn's gpu_info.json for these model families.
+constexpr std::array<WebGLGPU, 3> kWebGLGPUs = {{
+    {"Google Inc. (Intel)",
+     "ANGLE (Intel, Intel(R) UHD Graphics 770 (0x0000A780) Direct3D11 "
+     "vs_5_0 ps_5_0, D3D11)",
+     "intel", "gen-12-lp", 50},
+    {"Google Inc. (NVIDIA)",
+     "ANGLE (NVIDIA, NVIDIA GeForce RTX 3060 Direct3D11 vs_5_0 ps_5_0, "
+     "D3D11)",
+     "nvidia", "ampere", 35},
+    {"Google Inc. (AMD)",
+     "ANGLE (AMD, AMD Radeon(TM) Graphics (0x000015D8) Direct3D11 vs_5_0 "
+     "ps_5_0, D3D11)",
+     "amd", "gcn-5", 15},
+}};
+
+constexpr std::array<WebGLGPU, 3> kLinuxWebGLGPUs = {{
+    {"Google Inc. (Intel)",
+     "ANGLE (Intel, Mesa Intel(R) UHD Graphics 770 (ADL-S GT1), OpenGL 4.6)",
+     "intel", "gen-12-lp", 50},
+    {"Google Inc. (NVIDIA Corporation)",
+     "ANGLE (NVIDIA Corporation, NVIDIA GeForce RTX 3060/PCIe/SSE2, "
+     "OpenGL 4.6.0 NVIDIA 570.133.07)", "nvidia", "ampere", 35},
+    {"Google Inc. (AMD)",
+     "ANGLE (AMD, AMD Radeon RX 6600 (radeonsi, navi23, LLVM 19.1.7, "
+     "DRM 3.61, 6.14.0), OpenGL 4.6)", "amd", "rdna-2", 15},
+}};
+constexpr std::array<WebGLGPU, 3> kMacArmWebGLGPUs = {{
+    {"Google Inc. (Apple)",
+     "ANGLE (Apple, ANGLE Metal Renderer: Apple M1, Unspecified Version)",
+     "apple", "apple-7", 35},
+    {"Google Inc. (Apple)",
+     "ANGLE (Apple, ANGLE Metal Renderer: Apple M2, Unspecified Version)",
+     "apple", "apple-8", 35},
+    {"Google Inc. (Apple)",
+     "ANGLE (Apple, ANGLE Metal Renderer: Apple M3, Unspecified Version)",
+     "apple", "apple-9", 30},
+}};
+constexpr std::array<WebGLGPU, 2> kMacIntelWebGLGPUs = {{
+    {"Google Inc. (Intel)",
+     "ANGLE (Intel, ANGLE Metal Renderer: Intel(R) Iris(TM) Plus Graphics 655, "
+     "Unspecified Version)", "intel", "gen-9", 65},
+    {"Google Inc. (AMD)",
+     "ANGLE (AMD, ANGLE Metal Renderer: AMD Radeon Pro 5500M, "
+     "Unspecified Version)", "amd", "rdna-1", 35},
+}};
+
+std::string GpuPlatform(const base::UxrConfig& config) {
+  std::string platform = base::ToLowerASCII(config.Get("uxr-ua-platform"));
+  if (platform.empty())
+    platform = base::ToLowerASCII(config.Get("uxr-platform"));
+  if (platform.empty()) {
+#if BUILDFLAG(IS_WIN)
+    platform = "windows";
+#elif BUILDFLAG(IS_MAC)
+    platform = "macos";
+#else
+    platform = "linux";
+#endif
+  }
+  return platform;
+}
+
+bool SupportsSeededWebGLPool(const base::UxrConfig& config) {
+  const std::string platform = GpuPlatform(config);
+  return platform == "windows" || platform == "win32" ||
+         platform == "macos" || platform == "macintel" ||
+         platform == "linux" || platform == "linux x86_64";
+}
+
+uint64_t SeedFromConfig(const base::UxrConfig& config) {
+  uint64_t seed = 0;
+  const char* key = config.Get("uxr-fingerprint-seed").empty()
+                        ? "uxr-canvas-seed"
+                        : "uxr-fingerprint-seed";
+  if (!config.GetUint64(key, &seed))
+    return 0;
+  return seed;
+}
+
+std::string GpuVendorToken(const std::string& name) {
+  const std::string value = base::ToLowerASCII(name);
+  if (value.find("nvidia") != std::string::npos) return "nvidia";
+  if (value.find("intel") != std::string::npos) return "intel";
+  if (value.find("amd") != std::string::npos ||
+      value.find("ati technologies") != std::string::npos) return "amd";
+  if (value.find("apple") != std::string::npos) return "apple";
+  return "";
+}
+
+template <size_t N>
+const WebGLGPU* PickWebGLGPU(const std::array<WebGLGPU, N>& pool,
+                            uint64_t seed,
+                            const std::string& vendor_hint,
+                            const std::string& renderer_hint) {
+  for (const auto& gpu : pool)
+    if (renderer_hint == gpu.renderer)
+      return &gpu;
+  unsigned total_weight = 0;
+  for (const auto& gpu : pool)
+    if (vendor_hint.empty() || vendor_hint == gpu.webgpu_vendor)
+      total_weight += gpu.weight;
+  if (!total_weight)
+    return nullptr;  // No compatible counterpart on this platform.
+  std::mt19937_64 rng(seed);
+  // Engine output and integer mapping are stable across standard libraries.
+  unsigned bucket = static_cast<unsigned>(rng() % total_weight);
+  for (const auto& gpu : pool) {
+    if (!vendor_hint.empty() && vendor_hint != gpu.webgpu_vendor)
+      continue;
+    if (bucket < gpu.weight)
+      return &gpu;
+    bucket -= gpu.weight;
+  }
+  return nullptr;
+}
+
+const WebGLGPU* SelectSeededWebGLGPU(const base::UxrConfig& config) {
+  const uint64_t seed = SeedFromConfig(config);
+  const std::string platform = GpuPlatform(config);
+  const std::string renderer = config.Get("uxr-webgl-renderer");
+  std::string hint = GpuVendorToken(renderer);
+  if (hint.empty())
+    hint = GpuVendorToken(config.Get("uxr-webgl-vendor"));
+  if (platform == "linux" || platform == "linux x86_64")
+    return PickWebGLGPU(kLinuxWebGLGPUs, seed, hint, renderer);
+  if (platform == "macos" || platform == "macintel") {
+    const std::string architecture = config.Get("uxr-ua-arch");
+    bool arm = architecture == "arm";
+#if defined(ARCH_CPU_ARM64) || defined(ARCH_CPU_ARMEL)
+    if (architecture.empty())
+      arm = true;
+#endif
+    return arm ? PickWebGLGPU(kMacArmWebGLGPUs, seed, hint, renderer)
+               : PickWebGLGPU(kMacIntelWebGLGPUs, seed, hint, renderer);
+  }
+  return PickWebGLGPU(kWebGLGPUs, seed, hint, renderer);
+}
+
+void OverrideWebGLGPU(PersonaProfile* profile,
+                      const base::UxrConfig& config) {
+  if (profile->webgl_real || profile->webgl_identity_explicit)
+    return;
+  const WebGLGPU* gpu = SelectSeededWebGLGPU(config);
+  profile->webgl_vendor = gpu ? gpu->vendor : "";
+  profile->webgl_renderer = gpu ? gpu->renderer : "";
+  profile->webgpu_vendor = gpu ? gpu->webgpu_vendor : "";
+  profile->webgpu_architecture = gpu ? gpu->webgpu_architecture : "";
+}
+
+void OverrideInt(const base::UxrConfig& config, const char* key, int* value) {
+  int parsed = 0;
+  if (config.GetInt(key, &parsed) && parsed >= 0)
+    *value = parsed;
+}
+
+void OverrideFloat(const base::UxrConfig& config,
+                   const char* key,
+                   float* value) {
+  double parsed = 0.0;
+  if (config.GetDouble(key, &parsed) && parsed >= 0.0 &&
+      parsed <= std::numeric_limits<float>::max())
+    *value = static_cast<float>(parsed);
+}
+
+bool ConfigSwitchEnabled(const base::UxrConfig& config, const char* key) {
+  if (!config.Has(key))
+    return false;
+  const std::string value = config.Get(key);
+  return value.empty() || value == "1" || value == "true";
+}
+
+std::vector<std::string> SplitExtensions(const std::string& raw) {
+  std::vector<std::string> result;
+  size_t begin = 0;
+  while (begin < raw.size()) {
+    size_t end = raw.find(',', begin);
+    if (end == std::string::npos)
+      end = raw.size();
+    if (end > begin)
+      result.push_back(raw.substr(begin, end - begin));
+    begin = end + 1;
+  }
+  return result;
+}
+
+PersonaProfile BuildPersona() {
+  PersonaProfile p;
+  const base::UxrConfig& config = base::UxrConfig::GetInstance();
+  const bool explicit_identity = !config.Get("uxr-webgl-vendor").empty() ||
+                                 !config.Get("uxr-webgl-renderer").empty();
+  // No flags means native. Public fingerprint mode and explicit GPU switches
+  // work without the independent synthetic hardware-test opt-in.
+  if (ConfigSwitchEnabled(config, "uxr-fingerprint-off") ||
+      (!ConfigSwitchEnabled(config, "uxr-fingerprint-enabled") &&
+       !ConfigSwitchEnabled(config, "uxr-synthetic-device-tests") &&
+       !explicit_identity)) {
+    p.webgl_real = true;
+    return p;
+  }
+  p.webgl_native_capabilities =
+      !ConfigSwitchEnabled(config, "uxr-synthetic-device-tests");
+  const std::string vendor = config.Get("uxr-webgl-vendor");
+  const std::string renderer = config.Get("uxr-webgl-renderer");
+  p.webgl_fingerprint = ConfigSwitchEnabled(config, "uxr-webgl-fingerprint");
+  p.webgl_real = ConfigSwitchEnabled(config, "uxr-webgl-real") ||
+                 ConfigSwitchEnabled(config, "uxr-disable-gpu-fingerprint");
+  if (!explicit_identity &&
+      (!SupportsSeededWebGLPool(config) || SeedFromConfig(config) == 0)) {
+    p.webgl_real = true;
+  }
+  OverrideWebGLGPU(&p, config);
+  if (!p.webgl_real && explicit_identity) {
+    // Select a counterpart from the same vendor before applying either flag.
+    // Unknown one-sided identities stay incomplete rather than acquire an
+    // unrelated seeded vendor/renderer. Complete caller tuples remain exact.
+    const std::string selected_renderer = p.webgl_renderer;
+    if (!vendor.empty()) {
+      p.webgl_vendor = vendor;
+      if (renderer.empty() && GpuVendorToken(vendor).empty())
+        p.webgl_renderer.clear();
+    }
+    if (!renderer.empty()) {
+      p.webgl_renderer = renderer;
+      if (vendor.empty() && GpuVendorToken(renderer).empty())
+        p.webgl_vendor.clear();
+    }
+    p.webgl_identity_explicit = true;
+    const std::string renderer_vendor = GpuVendorToken(p.webgl_renderer);
+    const bool coherent = !renderer_vendor.empty() &&
+        renderer_vendor == GpuVendorToken(p.webgl_vendor);
+    p.webgpu_vendor = coherent ? renderer_vendor : "";
+    // Only an exact known renderer can certify a Dawn architecture token.
+    if (!coherent || p.webgl_renderer != selected_renderer)
+      p.webgpu_architecture.clear();
+  }
+
+  const std::string platform = config.Get("uxr-platform");
+  p.mobile = platform == "android" || platform == "Android";
+
+  OverrideInt(config, "uxr-webgl-max-texture-size", &p.webgl_max_texture_size);
+  OverrideInt(config, "uxr-webgl-max-cube-map-texture-size",
+              &p.webgl_max_cube_map_texture_size);
+  OverrideInt(config, "uxr-webgl-max-renderbuffer-size",
+              &p.webgl_max_renderbuffer_size);
+  OverrideInt(config, "uxr-webgl-max-viewport-dim", &p.webgl_max_viewport_dim);
+  OverrideInt(config, "uxr-webgl-max-vertex-uniform-vectors",
+              &p.webgl_max_vertex_uniform_vectors);
+  OverrideInt(config, "uxr-webgl-max-fragment-uniform-vectors",
+              &p.webgl_max_fragment_uniform_vectors);
+  OverrideInt(config, "uxr-webgl-max-varying-vectors",
+              &p.webgl_max_varying_vectors);
+  OverrideInt(config, "uxr-webgl-max-combined-texture-image-units",
+              &p.webgl_max_combined_texture_image_units);
+  OverrideInt(config, "uxr-webgl-max-texture-image-units",
+              &p.webgl_max_texture_image_units);
+  OverrideInt(config, "uxr-webgl-max-vertex-attribs",
+              &p.webgl_max_vertex_attribs);
+  OverrideInt(config, "uxr-webgl-max-vertex-texture-image-units",
+              &p.webgl_max_vertex_texture_image_units);
+  OverrideInt(config, "uxr-webgl-max-combined-fragment-uniform-components",
+              &p.webgl_max_combined_fragment_uniform_components);
+  OverrideInt(config, "uxr-webgl-max-combined-vertex-uniform-components",
+              &p.webgl_max_combined_vertex_uniform_components);
+  OverrideInt(config, "uxr-webgl-max-transform-feedback-interleaved-components",
+              &p.webgl_max_transform_feedback_interleaved_components);
+  OverrideInt(config, "uxr-webgl-max-transform-feedback-separate-attribs",
+              &p.webgl_max_transform_feedback_separate_attribs);
+  OverrideInt(config, "uxr-webgl-max-uniform-block-size",
+              &p.webgl_max_uniform_block_size);
+  OverrideInt(config, "uxr-webgl-max-3d-texture-size",
+              &p.webgl_max_3d_texture_size);
+  OverrideInt(config, "uxr-webgl-max-array-texture-layers",
+              &p.webgl_max_array_texture_layers);
+  OverrideInt(config, "uxr-webgl-max-draw-buffers", &p.webgl_max_draw_buffers);
+  OverrideInt(config, "uxr-webgl-max-color-attachments",
+              &p.webgl_max_color_attachments);
+  OverrideInt(config, "uxr-webgl-max-samples", &p.webgl_max_samples);
+  OverrideInt(config, "uxr-webgl-max-vertex-uniform-blocks",
+              &p.webgl_max_vertex_uniform_blocks);
+  OverrideInt(config, "uxr-webgl-max-fragment-uniform-blocks",
+              &p.webgl_max_fragment_uniform_blocks);
+  OverrideInt(config, "uxr-webgl-max-combined-uniform-blocks",
+              &p.webgl_max_combined_uniform_blocks);
+  OverrideInt(config, "uxr-webgl-max-uniform-buffer-bindings",
+              &p.webgl_max_uniform_buffer_bindings);
+  OverrideFloat(config, "uxr-webgl-max-texture-lod-bias",
+                &p.webgl_max_texture_lod_bias);
+  OverrideInt(config, "uxr-webgl-max-vertex-uniform-components",
+              &p.webgl_max_vertex_uniform_components);
+  OverrideInt(config, "uxr-webgl-max-fragment-uniform-components",
+              &p.webgl_max_fragment_uniform_components);
+  OverrideFloat(config, "uxr-webgl-max-anisotropy",
+                &p.webgl_max_texture_max_anisotropy);
+
+  const std::string extensions = config.Get("uxr-webgl-extensions");
+  if (!extensions.empty())
+    p.webgl_extensions = SplitExtensions(extensions);
+  return p;
+}
+
+}  // namespace
+
+const PersonaProfile& CurrentPersona() {
+  static PersonaProfile* profile = nullptr;
+  static std::once_flag once;
+  std::call_once(once, [] { profile = new PersonaProfile(BuildPersona()); });
+  return *profile;
+}
