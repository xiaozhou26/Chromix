 bool DOMPluginArray::IsPdfViewerAvailable() {
+  // UXR: persona plugin shape. Every real desktop Chrome reports the
+  // spec'd five-entry PDF list; an empty navigator.plugins is the classic
+  // automation tell from configurations where the internal PDF viewer did not
+  // register (headless variants, stripped builds). With uxr-plugins=chrome the
+  // standard shape is presented regardless — this method also drives
+  // navigator.pdfViewerEnabled, so the surface stays coherent.
+  if (base::UxrConfig::GetInstance().Get("uxr-plugins") == "chrome") {
+    return true;
+  }
   auto* data = GetPluginData();
   if (!data)
     return false;
