+const std::string& GetEffectiveUserAgentFullVersion() {
+  static const base::NoDestructor<std::string> version([] {
+    std::string override_version =
+        base::UxrConfig::GetInstance().Get("uxr-ua-full-version");
+    if (override_version.empty()) {
+      const base::CommandLine* command_line =
+          base::CommandLine::ForCurrentProcess();
+      if (command_line->HasSwitch("uxr-ua-full-version")) {
+        override_version =
+            command_line->GetSwitchValueASCII("uxr-ua-full-version");
+      }
+    }
+    base::Version parsed_version(override_version);
+    int major_version = 0;
+    if (parsed_version.IsValid() &&
+        base::StringToInt(base::NumberToString(parsed_version.components()[0]),
+                          &major_version) && major_version > 0) {
+      return override_version;
+    }
+    return std::string(version_info::GetVersionNumber());
+  }());
+  return *version;
+}
+
+std::string GetEffectiveBrowserBrandFullVersion() {
+  const std::string version = base::CommandLine::ForCurrentProcess()->
+      GetSwitchValueASCII("uxr-ua-brand-version");
+  const base::Version parsed(version);
+  int major = 0;
+  return parsed.IsValid() &&
+         base::StringToInt(base::NumberToString(parsed.components()[0]), &major) && major > 0
+             ? version : GetEffectiveUserAgentFullVersion();
+}
+
+std::string BrowserBrandProductToken(const std::string& brand) {
+  if (brand == "Microsoft Edge") return "Edg";
+  if (brand == "Opera") return "OPR";
+  if (brand == "Vivaldi") return "Vivaldi";
+  return "";
+}
+
+const std::string& GetEffectiveUserAgentMajorVersion() {
+  static const base::NoDestructor<std::string> major_version([] {
+    base::Version version(GetEffectiveUserAgentFullVersion());
+    DCHECK(version.IsValid());
+    return base::NumberToString(version.components()[0]);
+  }());
+  return *major_version;
+}
+
+std::string ReplaceProductVersion(const std::string& product,
+                                  const std::string& version) {
+  size_t separator = product.find("Chrome/");
+  if (separator == std::string::npos)
+    separator = product.find("Chromium/");
+  if (separator == std::string::npos)
+    return product;
+  separator = product.find('/', separator);
+  const size_t version_end = product.find(' ', separator + 1);
+  std::string result = product;
+  result.replace(separator + 1, version_end == std::string::npos
+                                    ? std::string::npos
+                                    : version_end - separator - 1,
+                 version);
+  return result;
+}
